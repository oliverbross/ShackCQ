@@ -140,0 +143,14 @@ fn main() {
+/// Rust's Windows canonicalization returns a verbatim `\\?\` path. MinGW
+/// gfortran receives CMake's slash-normalized `//?/D:/...` form and treats the
+/// source operand as `//file.f90`, so preprocessing fails before compilation.
+/// CMake accepts an ordinary absolute drive path and preserves it correctly.
+fn windows_cmake_path(path: PathBuf) -> PathBuf {
+    if cfg!(windows) {
+        let display = path.to_string_lossy();
+        if let Some(ordinary) = display.strip_prefix(r"\\?\") {
+            return PathBuf::from(ordinary);
+        }
+    }
+    path
+}
